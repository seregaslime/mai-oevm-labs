{ Лабораторная работа №2 (№4 по методичке)                           }
{ Моделирование функционирования операционной части ЦП              }
{ Вариант 7: 1-й операнд - прямая адресация,                        }
{            2-й операнд - косвенно-регистровая адресация,          }
{            результат записывается на место 1-го операнда.         }
{ Формат команды RK: KOP[15..14] OP1[13..7] OP2[6..0], KOP=1 (+)    }
{ Регистры, ZS, RON и RK объявлены в среде MCL для этой лабораторной }

writeln "**************************************************";
writeln "*  Моделирование операционной части ЦП. Вар. 7   *";
writeln "*  1-й операнд: прямая адресация                 *";
writeln "*  2-й операнд: косвенно-регистровая адресация   *";
writeln "**************************************************";

{ Исходные данные: команда, операнды и адрес 2-го операнда в РОНе }
ZS[1] := 17284;   { команда: KOP=01, OP1=0000111 (7), OP2=0000100 (4) }
ZS[7] := 15;      { 1-й операнд (прямой адрес 7) }
ZS[10] := 6;      { 2-й операнд (адрес 10 хранится в РОН 4) }
RON[4] := 10;     { адрес 2-го операнда }
PAUSE;

{ 1 этап. Выбор команды из памяти }
RAP := SK;
PAUSE;
RCH := ZS[RAP];
PAUSE;
RK := RCH;
PAUSE;
SK := SK+1;
PAUSE;
writeln "RK=",$B16 RK;

{ 2 этап. Дешифрация кода операции: KOP=1 - сложение }

{ 3 этап. Выбор 1-го операнда - прямая адресация }
{ в поле OP1 задан исполнительный адрес операнда в ОП }
RAP := RK.OP1;
PAUSE;
RCH := ZS[RAP];
PAUSE;
RA := RCH;
PAUSE;
writeln "RA=",$B16 RA,"=",$D5 RA;

{ 3 этап. Выбор 2-го операнда - косвенно-регистровая адресация }
{ в поле OP2 задан номер РОНа, в котором хранится адрес операнда в ОП }
RARP := RK.OP2;
PAUSE;
RCHR := RON[RARP];
PAUSE;
RAP := RCHR;
PAUSE;
RCH := ZS[RAP];
PAUSE;
RB := RCH;
PAUSE;
writeln "RB=",$B16 RB,"=",$D5 RB;

{ 4 этап. Выполнение операции в АЛУ }
RC := RA+RB;
PAUSE;
writeln "RC=",$B16 RC,"=",$D5 RC;

{ 5 этап. Запись результата на место 1-го операнда (в ОП по адресу OP1) }
RAP := RK.OP1;
PAUSE;
RCH := RC;
PAUSE;
ZS[RAP] := RCH;
PAUSE;

writeln "Результат записан в ячейку ОП с адресом ",$D2 RAP;
writeln "***************** Конец программы ****************";

END;
